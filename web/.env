# ─────────────────────────────────────────────────────────────────────
#  Configuración para `npm run dev` (ambas apps).
#  VITE_BACKEND=api  → API real (Vite redirige /api a http://localhost:5080)
#  VITE_BACKEND=demo → backend simulado en el navegador (no hace falta correr la API)
# ─────────────────────────────────────────────────────────────────────
VITE_BACKEND=api
VITE_API_URL=/api
