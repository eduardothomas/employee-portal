# ─────────────────────────────────────────────────────────────────────
#  Valores por defecto de los builds de producción (GitHub Pages).
#
#  En GitHub Actions se pueden sobrescribir SIN tocar este archivo:
#    Settings → Secrets and variables → Actions → Variables
#      PAGES_BACKEND = demo | api
#      PAGES_API_URL = https://employee-portal-api.onrender.com
#  o al lanzar el workflow "Deploy GitHub Pages" a mano (Run workflow → backend).
#
#  VITE_BACKEND=demo → backend simulado en el navegador (funciona sin servidor)
#  VITE_BACKEND=api  → API real en VITE_API_URL (sin "/" al final)
# ─────────────────────────────────────────────────────────────────────
VITE_BACKEND=demo
VITE_API_URL=https://employee-portal-api.onrender.com

# GitHub Pages no soporta rutas del lado del cliente: usar rutas con # (/#/payroll).
VITE_ROUTER=hash
