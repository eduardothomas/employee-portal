{
  "name": "employee-portal-web",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:employee": "npm run dev -w @ep/employee",
    "dev:admin": "npm run dev -w @ep/admin",
    "build": "npm run build -w @ep/employee && npm run build -w @ep/admin",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
