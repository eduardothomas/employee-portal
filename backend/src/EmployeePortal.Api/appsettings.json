{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=employee_portal;Username=portal;Password=portal"
  },
  "Database": {
    "Provider": "Postgres",
    "Seed": true
  },
  "Jwt": {
    "Issuer": "EmployeePortal",
    "Audience": "EmployeePortal",
    "SigningKey": "CHANGE-ME-in-production-use-a-64-char-random-secret-from-a-vault",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "ExposeMfaCodeInResponse": false
  },
  "Cors": {
    "Origins": "http://localhost:5173,http://localhost:5174"
  }
}
